# ============================================================
# ValueLens AI Environment Configuration
# ============================================================

# Database (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/valuelens_db
SPRING_DATASOURCE_USERNAME=valuelens_user
SPRING_DATASOURCE_PASSWORD=valuelens_password

# NVIDIA NIM AI Inference
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_TEMPERATURE=0.2
NVIDIA_TOP_P=0.7
NVIDIA_MAX_TOKENS=2048

# Frontend Public Base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Active Spring Profile (dev uses in-memory H2 PostgreSQL mode for zero-setup execution)
SPRING_PROFILES_ACTIVE=dev
