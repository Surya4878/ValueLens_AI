# ==============================================================================
# Business ValueLens AI — Production Environment Variables Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Never commit real credentials to this file or Git.
# 2. Duplicate this file as `.env` (backend) and `.env.local` (frontend).
# 3. Supply production secrets via Cloud Secrets Manager, Vault, or secure CI/CD.
# ==============================================================================

# ==============================================================================
# [PUBLIC] Client-Side Variables (Injected into browser bundle)
# ==============================================================================
NEXT_PUBLIC_API_BASE_URL=https://api.valuelens.your-domain.com
NEXT_PUBLIC_APP_URL=https://valuelens.your-domain.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=your-microsoft-entra-app-client-id

# ==============================================================================
# [SERVER-ONLY] Backend Database & Connection
# ==============================================================================
DATABASE_URL=jdbc:postgresql://your-database-host:5432/postgres?sslmode=require
DATABASE_USER=postgres
DATABASE_PASSWORD=your-database-password
SPRING_PROFILES_ACTIVE=prod

# ==============================================================================
# [SERVER-ONLY] Security, Sessions & Cryptography
# ==============================================================================
# Must be at least 256 bits (32+ random characters). Never use default in production!
JWT_SECRET=your-secure-random-256-bit-jwt-secret-min-32-chars
JWT_EXPIRATION_MS=86400000
COOKIE_SECURE=true
RATE_LIMIT_ENABLED=true
FRONTEND_URL=https://valuelens.your-domain.com
CORS_ALLOWED_ORIGINS=https://valuelens.your-domain.com

# ==============================================================================
# [SERVER-ONLY] OAuth Provider Verification Secrets
# ==============================================================================
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
MICROSOFT_CLIENT_ID=your-microsoft-entra-app-client-id
MICROSOFT_TENANT_ID=common

# ==============================================================================
# [SERVER-ONLY] Email Service / SMTP Relay
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-reply@valuelens.your-domain.com
SMTP_PASS=your-smtp-application-password
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=no-reply@valuelens.your-domain.com
EMAIL_SMTP_PASSWORD=your-smtp-application-password
EMAIL_FROM=no-reply@valuelens.your-domain.com

# ==============================================================================
# [SERVER-ONLY] AI Decision Engine (NVIDIA NIM)
# ==============================================================================
NVIDIA_API_KEY=your-nvidia-nim-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_TEMPERATURE=0.6
NVIDIA_MAX_TOKENS=1500
NVIDIA_TIMEOUT_SECONDS=35